# SafeAir AI - Environment Configuration Template
# Copy this file to .env and insert your API keys:
# cp .env.example .env

# LLM Provider Configuration
# Supported: "groq", "ollama", "gemini", "mock"
LLM_PROVIDER=groq

# Groq Cloud API Key (Get free key from: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Name (Recommended on Groq: openai/gpt-oss-120b, openai/gpt-oss-20b, or llama-3.3-70b-versatile)
LLM_MODEL=openai/gpt-oss-120b

# Real-Time Air Quality & Weather API Keys
# WAQI (World Air Quality Index) - Get free token at: https://aqicn.org/data-platform/token/
WAQI_API_KEY=your_waqi_api_token_here

# OpenWeatherMap API Key - Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Application Defaults
DEFAULT_CITY=Bengaluru
DEFAULT_PERSONA=asthma_patient
CACHE_TTL_SECONDS=900
DEBUG_MODE=False
